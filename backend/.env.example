# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

PORT=3000
MONGO_URI=mongodb://localhost:27017/mughal-mahal

# Long random string used to sign login tokens (required).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account. Created automatically on first start if no admin exists.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gmail account + app password used to send OTP and reset emails
EMAIL_USER=
EMAIL_PASS=

# URL of the deployed frontend (used for CORS and email links)
FRONTEND_URL=http://localhost:5173
